{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maploom.dev/schemas/plugin-manifest-v1.schema.json",
  "title": "MapLoom Plugin Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "name", "displayName", "version", "description"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "packageName": { "type": "string" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "frameworkVersion": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/typedEntry" } },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/typedEntry" } },
    "styles": { "type": "array", "items": { "$ref": "#/$defs/typedEntry" } },
    "interactions": { "type": "array", "items": { "$ref": "#/$defs/typedEntry" } },
    "templates": { "type": "array", "items": { "$ref": "#/$defs/template" } }
  },
  "$defs": {
    "example": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "path": { "type": "string" },
        "value": {}
      }
    },
    "event": {
      "type": "object",
      "required": ["event"],
      "properties": {
        "event": { "type": "string" },
        "description": { "type": "string" },
        "payloadSchema": {},
        "example": {}
      }
    },
    "widget": {
      "type": "object",
      "required": ["type", "description", "schema", "examples"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "schema": {},
        "appSpec": {},
        "emits": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/example" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "description", "schema", "examples"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "schema": {},
        "appSpec": {},
        "requiresCapabilities": { "type": "array", "items": { "type": "object" } },
        "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/example" } }
      }
    },
    "capability": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "adapter": { "type": "string" },
        "inputSchema": {},
        "outputSchema": {},
        "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } }
      }
    },
    "typedEntry": {
      "type": "object",
      "required": ["type", "description", "schema"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "schema": {},
        "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } }
      }
    },
    "template": {
      "type": "object",
      "required": ["id", "title", "description", "appSpec"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "appSpec": { "type": "string" },
        "theme": { "type": "string" },
        "data": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
