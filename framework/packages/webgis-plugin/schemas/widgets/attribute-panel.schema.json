{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attribute-panel widget",
  "type": "object",
  "required": ["id", "type", "region", "fields"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "attribute-panel" },
    "region": { "enum": ["left", "right", "bottom", "top"] },
    "title": { "type": "string" },
    "className": { "type": "string" },
    "fields": { "type": "array", "items": { "type": "string" } },
    "bind": {
      "type": "object",
      "properties": { "feature": { "type": "string" } }
    }
  }
}
