{
  "version": "0.1",
  "state": {
    "selection": {
      "feature": null
    },
    "data": {
      "poi": {
        "query": {
          "district": "__all__"
        },
        "status": "idle"
      }
    },
    "analysis": {
      "dbscan": {
        "status": "idle"
      },
      "poiGrid": {
        "status": "idle"
      },
      "urbanFunction": {
        "status": "idle"
      }
    }
  },
  "map": {
    "container": "map",
    "center": [
      118.78,
      32.04
    ],
    "zoom": 10
  },
  "sources": [
    {
      "id": "districtSource",
      "type": "geojson",
      "url": "http://127.0.0.1:8000/api/boundary"
    },
    {
      "id": "poiSource",
      "type": "geojson",
      "url": "http://127.0.0.1:8000/api/poi",
      "query": {
        "district": "__all__",
        "limit": 10000,
        "sample": "proportional"
      }
    }
  ],
  "layers": [
    {
      "id": "districtLayer",
      "title": "Nanjing District Boundary",
      "type": "vector",
      "source": "districtSource",
      "visible": true,
      "style": {
        "type": "simple",
        "fillColor": "rgba(124,58,237,.05)",
        "strokeColor": "#7c3aed",
        "strokeWidth": 1.4
      }
    },
    {
      "id": "poiLayer",
      "title": "POI",
      "type": "vector",
      "source": "poiSource",
      "visible": true,
      "style": {
        "type": "category",
        "field": "function_type",
        "rules": {
          "商业消费": {"color": "#ef4444", "strokeColor": "#7f1d1d", "radius": 5},
          "居住生活": {"color": "#f59e0b", "strokeColor": "#78350f", "radius": 5},
          "教育文化": {"color": "#8b5cf6", "strokeColor": "#4c1d95", "radius": 5},
          "医疗健康": {"color": "#ec4899", "strokeColor": "#831843", "radius": 5},
          "交通设施": {"color": "#3b82f6", "strokeColor": "#1e3a8a", "radius": 5},
          "休闲游憩": {"color": "#22c55e", "strokeColor": "#14532d", "radius": 5},
          "公共管理": {"color": "#06b6d4", "strokeColor": "#164e63", "radius": 5},
          "商务就业": {"color": "#6366f1", "strokeColor": "#312e81", "radius": 5}
        },
        "default": {"color": "#64748b", "strokeColor": "#334155", "radius": 4}
      }
    }
  ],
  "widgets": [
    {"id": "layers", "type": "layer-list", "region": "left", "title": "Layer Control", "layers": ["districtLayer", "poiLayer"]},
    {
      "id": "poiFilter", "type": "filter-panel", "region": "left", "title": "POI Category Query",
      "statePath": "data.poi", "performanceTask": "poi-query",
      "fields": [
        {"field": "district", "label": "District", "value": "__all__"},
        {"field": "category_l1", "label": "Primary Category"},
        {"field": "category_l2", "label": "Secondary Category", "dependsOn": "category_l1"}
      ]
    },
    {"id": "gridAnalysis", "type": "poi-grid-analysis-panel", "region": "left", "title": "POI Grid Density", "sourceLayer": "poiLayer", "gridSizeMeters": 1000, "queryStatePath": "data.poi.query", "statePath": "analysis.poiGrid", "performanceTask": "grid-density"},
    {"id": "hotspotAnalysis", "type": "dbscan-clustering-panel", "region": "left", "title": "DBSCAN Hotspot Clustering", "sourceLayer": "poiLayer", "epsMeters": 800, "minPoints": 10, "queryStatePath": "data.poi.query", "statePath": "analysis.dbscan", "performanceTask": "dbscan"},
    {"id": "functionAnalysis", "type": "urban-function-analysis-panel", "region": "left", "title": "Urban Functional Zone Identification", "sourceLayer": "poiLayer", "gridSizeMeters": 1000, "minPoi": 10, "mixedThreshold": 0.7, "queryStatePath": "data.poi.query", "statePath": "analysis.urbanFunction", "performanceTask": "ufz"},
    {"id": "poiStats", "type": "statistics-panel", "region": "right", "title": "Current POI Overview", "sourceLayer": "poiLayer", "metrics": [{"type": "count", "label": "Loaded POIs"}, {"type": "group-count", "groupBy": "function_type", "label": "Urban Function Composition"}]},
    {"id": "functionProfile", "type": "urban-function-profile", "region": "right", "title": "Functional Grid Profile", "bind": {"feature": "selection.feature"}},
    {"id": "details", "type": "attribute-panel", "region": "right", "title": "Feature Details", "fields": ["name", "category_l1", "category_l2", "function_type", "district", "address", "poiCount", "density", "mixedDegree", "dominantFunction"], "bind": {"feature": "selection.feature"}},
    {"id": "analysisState", "type": "state-inspector", "region": "right", "title": "Spatial Analysis Runtime State", "path": "analysis"},
    {"id": "poiTable", "type": "attribute-table", "region": "bottom", "title": "POI Attribute Table", "sourceLayer": "poiLayer", "maxRows": 200, "fields": ["name", "category_l1", "category_l2", "function_type", "district", "address"]}
  ],
  "interactions": [
    {"id": "clickPoi", "type": "feature-click", "targetLayer": "poiLayer", "actions": [
      {"type": "set-state", "path": "selection.feature", "value": "$event.feature"},
      {"type": "highlight-feature", "feature": "$event.feature"},
      {"type": "show-popup", "feature": "$event.feature", "fields": ["name", "category_l1", "category_l2", "district", "address"]}
    ]}
  ],
  "bindings": [
    {"event": "widget.layers.layer-visibility-change", "actions": [{"type": "set-layer-visible", "target": "$event.layerId", "visible": "$event.visible"}]},
    {"event": "widget.poiFilter.filter-change", "actions": [
      {"type": "set-state", "path": "data.poi.query", "value": "$event.query"},
      {"type": "refresh-geojson-source", "source": "poiSource", "query": "$event.query", "statePath": "data.poi", "performanceTask": "poi-query"},
      {"type": "set-state", "path": "selection.feature", "value": null},
      {"type": "clear-highlight"}
    ]},
    {"event": "widget.gridAnalysis.run", "actions": [{"type": "run-poi-grid-analysis", "performanceTask": "grid-density", "endpoint": "http://127.0.0.1:8000/api/analysis/poi-grid", "sourceLayer": "$event.sourceLayer", "gridSizeMeters": "$event.gridSizeMeters", "query": "$event.query", "statePath": "analysis.poiGrid", "resultLayerId": "poiDensityGrid", "resultLayerTitle": "POI Density Grid"}]},
    {"event": "widget.hotspotAnalysis.run", "actions": [{"type": "run-dbscan-clustering", "performanceTask": "dbscan", "endpoint": "http://127.0.0.1:8000/api/analysis/dbscan", "sourceLayer": "$event.sourceLayer", "epsMeters": "$event.epsMeters", "minPoints": "$event.minPoints", "query": "$event.query", "statePath": "analysis.dbscan", "resultLayerId": "poiHotspots", "resultLayerTitle": "POI Hotspot Clusters", "hullLayerTitle": "DBSCAN Hotspot Extents", "centerLayerTitle": "DBSCAN Hotspot Centers"}]},
    {"event": "widget.functionAnalysis.run", "actions": [{"type": "run-urban-function-analysis", "performanceTask": "ufz", "endpoint": "http://127.0.0.1:8000/api/analysis/urban-function", "sourceLayer": "$event.sourceLayer", "gridSizeMeters": "$event.gridSizeMeters", "minPoi": "$event.minPoi", "mixedThreshold": "$event.mixedThreshold", "query": "$event.query", "statePath": "analysis.urbanFunction", "resultLayerId": "urbanFunctionZones", "resultLayerTitle": "Urban Functional Zones", "mixedLayerTitle": "Functional Mixed-use Degree", "functionField": "functionZone"}]},
    {"event": "widget.poiTable.row-click", "actions": [
      {"type": "set-state", "path": "selection.feature", "value": "$event.feature"},
      {"type": "highlight-feature", "feature": "$event.feature"},
      {"type": "zoom-to-feature", "feature": "$event.feature"},
      {"type": "show-popup", "feature": "$event.feature", "fields": ["name", "category_l1", "category_l2", "district", "address"]}
    ]}
  ]
}
